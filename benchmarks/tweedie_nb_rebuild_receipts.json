   "unpen_fit_brent": "uv run python benchmarks/tweedie_estimate_p_timing.py --case unpen --fit-mode fit --method brent",
   "fremtpl2_fitreml_asis": "run_once() of benchmarks/profile_tweedie_reml_fit.py (--dataset fremtpl2 --rows 100000 --no-probes), in-process, with TweedieScaleProfileData._bessel_saturated_log_likelihood and _bessel_saturated_score wrapped to count calls (arm 'asis') or to return None, forcing the series (arm 'series')",
   "fremtpl2_fitreml_series": "run_once() of benchmarks/profile_tweedie_reml_fit.py (--dataset fremtpl2 --rows 100000 --no-probes), in-process, with TweedieScaleProfileData._bessel_saturated_log_likelihood and _bessel_saturated_score wrapped to count calls (arm 'asis') or to return None, forcing the series (arm 'series')",
