{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "src/superglm/editor/app/api/**/*.js",
    "src/superglm/editor/app/chart/**/*.js",
    "src/superglm/editor/app/state/**/*.js",
    "src/superglm/editor/app/views/**/*.js",
    "tests/editor_frontend/**/*.js"
  ]
}
